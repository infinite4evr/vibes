# Ghostty terminal - made by linux-setup. Docs: https://ghostty.org/docs/config
# Reload after editing with Ctrl+Shift+,   List themes: ghostty +list-themes

theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 10%

window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-theme = ghostty
window-width = 110
window-height = 30
background-opacity = 0.96

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = cursor,sudo,title

# Handy default keys: Ctrl+Shift+T new tab · Ctrl+Shift+O split right · Ctrl+Shift+E split down
#                     Ctrl+Alt+Arrows move between splits · Ctrl+Shift+Enter zoom a split
