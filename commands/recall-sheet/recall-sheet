#!/usr/bin/env python3
"""
recall-sheet -- turn a PDF's highlights into a two-column, dictionary-style
active-recall PDF.

    PDF --stack-highlights--> .json (each word tagged as marked or context)
        --recall-sheet------> two-column layout (raw LaTeX inside Markdown)
        --md-to-pdf---------> final PDF

Each snippet becomes one row:

    LEFT  (cue)                 RIGHT (snippet)
    illness                     Leave for illness arising out of pregnancy
    maximum, one month          to leave with wages at the rate of maternity
                                benefit for a maximum period of one month.

Cover the right column and expand each cue into the full statement, or
cover the left column and recall which words were the key ones.

If the cue words of a snippet add up to more than --max-words words (default
10), or the highlight IS the whole snippet (nothing left to recall), the left
side is left empty and the snippet is written on the right only -- with its
highlighted part in bold, since there is no cue to hide it behind.

USAGE
    recall-sheet input.pdf                      # -> input_recall.pdf next to it
    recall-sheet input.pdf -o notes.pdf
    recall-sheet folder/                        # every PDF, recursively
    recall-sheet existing_highlights.md         # skip stack-highlights, reuse its .md
    recall-sheet book.json                      # or its --format json output (what `notes` feeds it)
    recall-sheet input.pdf -w 6                 # cues longer than 6 words -> right only
    recall-sheet input.pdf -w 0                 # never skip the left side
    recall-sheet input.pdf --right cloze        # blank out highlighted words on the right
    recall-sheet input.pdf --right bold         # keep the bold on the right
    recall-sheet input.pdf --context sentence   # passed through to stack-highlights
    recall-sheet input.pdf -s 11 --gap 1.5 --rule
    recall-sheet input.pdf -F "Noto Serif"     # body font, passed to md-to-pdf -F
    recall-sheet input.pdf --grey-context --right bold   # context grey, marks bold black
    recall-sheet input.pdf --space-every 5:4 --space-style ruled   # ruled writing space
    recall-sheet input.pdf --color-map "red=italic,green=skip"  # per-colour emphasis

The two helper commands are found on PATH as `stack-highlights` and
`md-to-pdf`. Each row is labelled (a LaTeX comment, prints nothing), so if
LaTeX ever stops on one snippet, md-to-pdf names it and makes the sheet
from the rest. Override with --stack-cmd / --md2pdf-cmd (or the env vars
RECALL_STACK_CMD / RECALL_MD2PDF_CMD) if they live elsewhere. NOTE: a true
shell alias (alias foo='...' in .bashrc) is invisible to any script -- if
that's how yours are set up, pass the real command, e.g.
    --stack-cmd "python3 ~/bin/stack_highlights.py"
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# ---------------------------------------------------------------------------
# Parsing stack-highlights' Markdown
# ---------------------------------------------------------------------------
_RULE_LINE = re.compile(r"^=+$")
_PAGE_LABEL = re.compile(r"^\[Page \d+\]")


def parse_runs(md_text):
    """Split one stack-highlights paragraph into [(text, is_bold, is_italic), ...],
    undoing its Markdown escaping (\\*, \\_, \\\\, leading \\#, \\3. ...).
    Handles **bold**, ***bold+italic*** (non-yellow marks) and *italic*."""
    runs, buf, bold, ital, i, n = [], [], False, False, 0, len(md_text)

    def flush():
        if buf:
            runs.append(("".join(buf), bold, ital))
            buf.clear()

    while i < n:
        c = md_text[i]
        if c == "\\" and i + 1 < n:
            buf.append(md_text[i + 1])
            i += 2
        elif md_text.startswith("***", i):
            flush()
            bold = not bold
            ital = not ital
            i += 3
        elif md_text.startswith("**", i):
            flush()
            bold = not bold
            i += 2
        elif c == "*":
            flush()
            ital = not ital
            i += 1
        else:
            buf.append(c)
            i += 1
    flush()
    return runs


def plain(md_text):
    return "".join(t for t, _b, _i in parse_runs(md_text))


_HEADING = re.compile(r"^(#{1,6})\s+(.*)$")
_SUB = re.compile(r"^(fn \S+|Note[^:]*):\s*(.*)$")


def split_hard_breaks(lines):
    """A line ending in an unescaped backslash is a hard line break (one
    list item per line in a grouped entry); other lines just wrap."""
    out, cur = [], []
    for l in lines:
        trail = len(l) - len(l.rstrip("\\"))
        if trail % 2 == 1:
            cur.append(l[:-1].rstrip())
            out.append(" ".join(cur))
            cur = []
        else:
            cur.append(l)
    if cur:
        out.append(" ".join(cur))
    return [x for x in out if x.strip()]


_CHECK_TITLE = "Check in book"
_CHECK_INTRO = "These highlights are not in the notes above."


def drop_check_in_book(content):
    """Remove the "Check in book" section stack-highlights appends when some
    highlights could not be placed. It lists pages to look up, not notes, so
    it must not become recall rows. The section runs from its heading (followed
    by the fixed intro line) to the next heading of the same or a higher level,
    a ==== banner, or the end of the file (--combine puts one per book)."""
    lines = content.split("\n")
    out, skip = [], None
    for i, line in enumerate(lines):
        s = line.strip()
        h = _HEADING.match(s)
        if skip is not None and ((h and len(h.group(1)) <= skip) or _RULE_LINE.match(s)):
            skip = None
        if skip is None and h and h.group(2).strip() == _CHECK_TITLE:
            nxt = next((l.strip() for l in lines[i + 1:] if l.strip()), "")
            if nxt.startswith(_CHECK_INTRO):
                skip = len(h.group(1))
        if skip is None:
            out.append(line)
    return "\n".join(out)


def read_items(md_path, plain_titles=False):
    """Items: ("header", level, text) and ("entry", [line runs], [(label, runs)]).
    Understands stack-highlights output old and new: '#' headings, grouped
    lists (hard line breaks), '> fn 7: ...' / '> Note: ...' lines, the
    ==== banners of --combine and [Page N] labels.

    With plain_titles, a '#' heading is not kept as a header: if it carries a
    highlight it becomes an ordinary entry, otherwise it is dropped."""
    content = drop_check_in_book(Path(md_path).read_text(encoding="utf-8"))
    items = []
    for para in re.split(r"\n\s*\n", content):
        lines = [l.strip() for l in para.strip().splitlines() if l.strip()]
        while lines:
            if _RULE_LINE.match(lines[0]):
                label_lines = []
                lines = lines[1:]
                while lines and not _RULE_LINE.match(lines[0]):
                    label_lines.append(lines.pop(0))
                lines = lines[1:]
                if label_lines:
                    items.append(("header", 1, plain(" ".join(label_lines))))
                continue
            if _PAGE_LABEL.match(lines[0]):
                lines = lines[1:]
                continue
            h = _HEADING.match(lines[0])
            if h:
                if plain_titles:
                    runs = parse_runs(h.group(2))
                    if any(b for _t, b, _i in runs):      # highlighted -> keep as a snippet
                        items.append(("entry", [runs], []))
                    # un-highlighted heading -> dropped
                else:
                    items.append(("header", len(h.group(1)), plain(h.group(2))))
                lines = lines[1:]
                continue
            if lines[0].startswith(">"):
                text = " ".join(l.lstrip(">").strip() for l in lines)
                m = _SUB.match(text)
                label, body = (m.group(1), m.group(2)) if m else ("", text)
                if items and items[-1][0] == "entry":
                    items[-1][2].append((label, parse_runs(body)))
                else:
                    items.append(("entry", [parse_runs(body)], []))
                break
            items.append(("entry", [parse_runs(l) for l in split_hard_breaks(lines)], []))
            break
    return items


def read_items_json(json_path):
    """Build the same items as read_items, but from stack-highlights' JSON
    (the shared data model) -- no Markdown re-parsing, so nothing has to undo
    escaping. Runs arrive already structured as {text, mark, italic}; headers
    are reconstructed from each entry's heading crumb path."""
    data = json.loads(Path(json_path).read_text(encoding="utf-8"))
    items = []
    shown = []   # crumb path already emitted, as [(level, text)]

    def to_runs(run_list):
        return [(r["text"], bool(r["mark"]), bool(r["italic"])) for r in run_list]

    for e in data.get("entries", []):
        path = [(h["level"], h["text"]) for h in e.get("headings", [])]
        k = 0
        while k < len(path) and k < len(shown) and path[k] == shown[k]:
            k += 1
        for level, text in path[k:]:
            items.append(("header", level, text))
        shown = path
        if e["kind"] == "heading":
            continue   # its text is already the header emitted from the crumbs
        lines = [to_runs(ln["runs"]) for ln in e.get("lines", [])]
        subs = [(s.get("label", ""), to_runs(s["runs"])) for s in e.get("subs", [])]
        items.append(("entry", lines, subs))
    return items


# ---------------------------------------------------------------------------
# Building rows
# ---------------------------------------------------------------------------
def cues_for(runs):
    """Distinct highlighted phrases, in order, trimmed of edge punctuation."""
    cues, seen = [], set()
    for text, bold, ital in runs:
        if not bold:
            continue
        cue = " ".join(text.split()).strip(" ,;:.!?\u2014\u2013-‘’“”\"'()[]")
        if cue and cue.lower() not in seen:
            seen.add(cue.lower())
            cues.append((cue, ital))   # ital: a non-yellow mark under --italic-colors
    return cues


def highlight_is_whole_snippet(runs):
    """True when everything outside the bold is just punctuation/space --
    a cue identical to its snippet has no recall value."""
    rest = "".join(t for t, b, _i in runs if not b)
    return not re.search(r"\w", rest)


_TEX_SPECIAL = {
    "\\": r"\textbackslash{}", "&": r"\&", "%": r"\%", "$": r"\$", "#": r"\#",
    "_": r"\_", "{": r"\{", "}": r"\}", "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
}


# PDFs with custom-encoded fonts can put control characters (bullet and brace
# glyphs) into the text layer. LaTeX stops on them ("Text line contains an
# invalid character"), and they print nothing anyway, so they are dropped.
_CONTROL_CHARS = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")


# A run of this many characters without a space is not a word but a PDF text
# layer that lost its spaces. LaTeX cannot print one that long (its width
# overflows, and LaTeX then stops or even hangs), so it is split into pieces.
_LONG_RUN = re.compile(r"\S{500,}")
_PIECE = 80


def _split_long_run(m):
    w = m.group(0)
    pieces, last, k = [], 0, _PIECE
    while k < len(w):
        if w[k - 1].isalnum() and w[k].isalnum():
            pieces.append(w[last:k])
            last, k = k, k + _PIECE
        else:
            k += 1
    pieces.append(w[last:])
    return " ".join(pieces)


def tex(s):
    s = _LONG_RUN.sub(_split_long_run, _CONTROL_CHARS.sub("", s))
    return "".join(_TEX_SPECIAL.get(c, c) for c in s)


def render_right(runs, mode, grey=None):
    """Render the right (answer) column. With grey set (0=black .. 1=white),
    context words are printed in that grey. Marks shown in bold (--right bold)
    stay full black, so the eye lands on them; in plain mode the marks are
    deliberately not shown, so they are grey like everything else."""
    def ctx(s):
        # grey the context, but keep boundary spaces OUTSIDE the colour group
        # so interword spacing between a mark and its context survives
        if grey is None:
            return s
        core = s.strip()
        if not core:
            return s
        lead = s[:len(s) - len(s.lstrip())]
        trail = s[len(s.rstrip()):]
        return r"%s\textcolor[gray]{%.2f}{%s}%s" % (lead, grey, core, trail)

    out = []
    for text, bold, ital in runs:
        if bold and mode == "cloze":
            # one blank per word, each as wide as the hidden word
            out.append(" ".join(
                r"\underline{\phantom{%s}}" % tex(w) if w else "" for w in text.split(" ")
            ))
        elif bold and mode == "bold":
            inner = r"\textit{%s}" % tex(text) if ital else tex(text)
            out.append(r"\textbf{%s}" % inner)
        elif not bold and ital:            # a pure *italic* run (rare)
            out.append(ctx(r"\textit{%s}" % tex(text)))
        else:                              # plain, or bold hidden in plain mode
            out.append(ctx(tex(text)))
    return "".join(out)


def writing_space(m, style):
    """M lines of hand-writing space. 'blank' is empty vertical space (the
    original behaviour); 'ruled' draws faint full-width lines and 'dotted'
    faint dotted lines, one per writing line, so the gap is usable."""
    if style in ("ruled", "dotted"):
        fill = r"\rule{\linewidth}{0.2pt}" if style == "ruled" else r"\leavevmode\dotfill"
        line = r"\par\noindent\textcolor[gray]{0.72}{%s}\vspace{\baselineskip}" % fill
        return r"\par\vspace{0.5\baselineskip}" + line * m
    return r"\vspace{%d\baselineskip}" % m


HEAD_STYLE = {1: r"\Large\bfseries", 2: r"\large\bfseries", 3: r"\normalsize\bfseries"}


def split_row(runs, args):
    """(left, right, right_only) for one line of notes."""
    cues = cues_for(runs)
    grey = getattr(args, "grey_context", None)
    n_words = sum(len(c.split()) for c, _ in cues)
    too_long = args.max_words > 0 and n_words > args.max_words
    if not cues or too_long or highlight_is_whole_snippet(runs):
        return "", render_right(runs, "bold", grey), True   # no cue to hide behind: keep the bold
    left = ", ".join(r"\textit{%s}" % tex(c) if it else tex(c) for c, it in cues)
    return r"\textbf{%s}" % left, render_right(runs, args.right, grey), False


def build_latex(items, title, args):
    gutter = 0.04
    lw = args.left_width
    rw = 1.0 - lw - gutter
    sep = r"\hfill\vrule width 0.4pt\hfill" if args.rule else r"\hfill"
    gap = r"\par\vspace{%.2f\baselineskip}" % args.gap
    inner = r"\par\vspace{0.3\baselineskip}"

    def row(left, right):
        return (r"\noindent\parbox[t]{%.3f\linewidth}{\raggedright\strut %s}%s"
                r"\parbox[t]{%.3f\linewidth}{\raggedright %s}" % (lw, left, sep, rw, right))

    out = [r"\setlength{\parindent}{0pt}", r"\setlength{\parskip}{0pt}"]
    if title:
        out.append(r"{\Large\bfseries %s\par}\vspace{\baselineskip}" % tex(title))

    rows = skipped = 0
    last_space_at = 0
    for item in items:
        if args.space_n and rows - last_space_at >= args.space_n:
            out.append(writing_space(args.space_m, args.space_style))
            last_space_at = rows
        plain = item_text(item)
        bad = sorted({f"U+{ord(c):04X}" for c in _CONTROL_CHARS.findall(plain)})
        if bad:
            print(f"  warning  removed invisible character(s) {', '.join(bad)} (LaTeX cannot print them) "
                  f"from: “{short(plain)}”", file=sys.stderr)
        for run_ in _LONG_RUN.findall(_CONTROL_CHARS.sub("", plain)):
            print(f"  warning  split a {len(run_):,}-character run without spaces into lines (LaTeX cannot "
                  f"print one word that long) in: “{short(plain)}”", file=sys.stderr)
        try:
            if item[0] == "header":
                if args.no_headings:
                    continue
                _, level, text = item
                style = HEAD_STYLE.get(level, r"\normalsize\bfseries\itshape")
                out.append(note_label(plain) +
                           r"\vspace{0.6\baselineskip}{%s %s\par}\nopagebreak\vspace{0.4\baselineskip}\nopagebreak"
                           % (style, tex(text)))
                continue
            _, lines, subs = item
            parts = []
            n_rows = n_right_only = 0
            for runs in lines:
                if not "".join(t for t, _b, _i in runs).strip():
                    continue
                left, right, right_only = split_row(runs, args)
                parts.append(row(left, right))
                n_rows += 1
                n_right_only += right_only
            for label, runs in subs:
                left, right, right_only = split_row(runs, args)
                lab = r"\textit{%s:} " % tex(label) if label else ""
                parts.append(row(left, r"{\small %s%s}" % (lab, right)))
        except Exception as ex:   # one odd snippet must not stop the sheet
            print(f"  warning  could not lay out “{short(plain)}” ({type(ex).__name__}: {ex}); "
                  f"left it out", file=sys.stderr)
            continue
        rows += n_rows
        skipped += n_right_only
        if parts:
            out.append(note_label(plain) + inner.join(parts) + gap)
    return out, rows, skipped


def item_text(item):
    """The plain text of an item, for warnings and row labels."""
    if item[0] == "header":
        return item[2]
    _, lines, subs = item
    parts = ["".join(t for t, _b, _i in runs) for runs in lines]
    parts += ["".join(t for t, _b, _i in runs) for _label, runs in subs]
    return " ".join(p for p in parts if p.strip())


def short(text, n=70):
    text = " ".join(_CONTROL_CHARS.sub("", text).split())
    return text if len(text) <= n else text[:n - 1].rstrip() + "…"


def note_label(text):
    """A LaTeX comment naming the row. It prints nothing; md-to-pdf uses
    it to say which snippet it means if LaTeX ever stops on one."""
    return "% note: " + short(text, 100) + "\n"


def wrap_as_markdown(chunks):
    # A fenced raw block is passed to LaTeX verbatim by pandoc -- no Markdown
    # parsing of the content. The fence just has to be longer than any
    # backtick run inside it. Each chunk (a heading or a snippet's rows) gets
    # its own block: pandoc joins them with a blank line, which is exactly
    # how they were joined before, and md-to-pdf can then isolate a
    # single row if LaTeX ever stops on it.
    blocks = []
    for latex in chunks:
        longest = max((len(m) for m in re.findall(r"`+", latex)), default=0)
        fence = "`" * max(3, longest + 1)
        blocks.append(f"{fence}{{=latex}}\n{latex}\n{fence}\n")
    return "\n".join(blocks)


# ---------------------------------------------------------------------------
# Running the two helper commands
# ---------------------------------------------------------------------------
def resolve_cmd(name, override, env_var):
    cmd = override or os.environ.get(env_var) or name
    parts = shlex.split(os.path.expanduser(cmd))
    parts[0] = os.path.expanduser(parts[0])
    if not shutil.which(parts[0]) and not Path(parts[0]).is_file():
        sys.exit(f"error: can't find '{parts[0]}'. If '{name}' is a shell alias, scripts can't "
                 f"see it -- pass the real command via --{'stack' if 'stack' in name else 'md2pdf'}-cmd "
                 f"or {env_var}, or symlink it into a folder on your PATH.")
    return parts


def run(cmd):
    r = subprocess.run(cmd)
    if r.returncode != 0:
        raise RuntimeError(f"command failed ({r.returncode}): {' '.join(map(shlex.quote, cmd))}")


def process(src, out_pdf, args, stack_cmd, md2pdf_cmd):
    with tempfile.TemporaryDirectory() as td:
        td = Path(td)
        suffix = src.suffix.lower()
        if suffix == ".pdf":
            # extract the shared JSON model, not Markdown, so nothing here has
            # to re-parse Markdown or undo escaping (temp file: never clobbers
            # your own notes)
            hl = td / f"{src.stem}.json"
            stack_extra = ["--context", args.context, "--no-progress", "--format", "json"]
            if args.word_window:
                stack_extra += ["--word-window", str(args.word_window), "--word-side", args.word_side]
            if args.plain_titles:
                stack_extra += ["--plain-titles"]
            if args.italic_colors:
                stack_extra += ["--italic-colors"]
            if args.color_map:
                stack_extra += ["--color-map", args.color_map]
            run(stack_cmd + [str(src), "--out", str(hl)] + stack_extra)
            if not hl.exists():
                print(f"  skip     {src.name}: no highlights found", file=sys.stderr)
                return "empty"
            items = read_items_json(hl)
        elif suffix == ".json":
            hl = src
            items = read_items_json(hl)
        else:  # a Markdown file made by stack-highlights
            hl = src
            items = read_items(hl, plain_titles=args.plain_titles)
        title = None if args.no_title else src.stem
        chunks, rows, skipped = build_latex(items, title, args)
        if rows == 0:
            print(f"  skip     {src.name}: no snippets to lay out", file=sys.stderr)
            return "empty"

        recall_md = td / f"{out_pdf.stem}.md"
        recall_md.write_text(wrap_as_markdown(chunks), encoding="utf-8")

        cmd = list(md2pdf_cmd)
        if args.font_size:
            cmd += ["-s", str(args.font_size)]
        if args.font_name:
            cmd += ["-F", args.font_name]
        if args.page_number:
            cmd += ["-p", args.page_number]
        if args.italic:
            cmd += ["-i"]
        run(cmd + [str(recall_md), str(out_pdf)])

        if args.keep_md:
            if hl.parent == td:
                shutil.copy(hl, out_pdf.with_name(out_pdf.stem + "_highlights" + hl.suffix))
            shutil.copy(recall_md, out_pdf.with_suffix(".md"))

        print(f"  done     {src.name} -> {out_pdf}  ({rows} rows, {skipped} right-only)",
              file=sys.stderr)
        return "ok"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", help="A highlighted PDF, a folder of PDFs, or an .md/.json made by stack-highlights")
    ap.add_argument("-o", "--out", help="Output PDF (single-file mode). Default: <name>_recall.pdf next to input")
    ap.add_argument("-w", "--max-words", type=int, default=10,
                    help="If a snippet's highlighted words total more than this, skip the left "
                         "column for it and write it on the right only (default: 10; 0 = never skip)")
    ap.add_argument("--right", choices=["plain", "bold", "cloze"], default="plain",
                    help="How the snippet shows on the right when it has a cue on the left: "
                         "'plain' (default) no bold, 'bold' keep the bold, 'cloze' blank out "
                         "the highlighted words")
    ap.add_argument("--context", choices=["sentence", "clause", "comma", "paragraph", "highlight"], default="sentence",
                    help="Passed to stack-highlights (default: sentence)")
    ap.add_argument("--word-window", type=int, default=0, metavar="N",
                    help="Passed to stack-highlights: keep N context words around each highlight (e.g. 6 = 3+3). 0 = off")
    ap.add_argument("--word-side", choices=["both", "left", "right"], default="both",
                    help="Passed to stack-highlights with --word-window (default: both)")
    ap.add_argument("--plain-titles", action="store_true",
                    help="Don't treat headings specially: a highlighted heading becomes an ordinary row, "
                         "an un-highlighted one is dropped")
    ap.add_argument("--italic-colors", action="store_true",
                    help="Passed to stack-highlights: non-yellow highlights become bold+italic")
    ap.add_argument("--color-map", metavar="MAP",
                    help="Passed to stack-highlights: per-colour emphasis, e.g. 'red=italic,green=skip'")
    ap.add_argument("--space-every", metavar="N:M",
                    help="After every N rows insert M blank lines of writing space (e.g. 5:10)")
    ap.add_argument("--space-style", choices=["blank", "ruled", "dotted"], default="blank",
                    help="With --space-every: leave the gap blank (default), or fill it with faint ruled or dotted lines")
    ap.add_argument("--grey-context", nargs="?", type=float, const=0.45, default=None, metavar="SHADE",
                    help="Print context words in grey (0=black .. 1=white; default 0.45). Use with --right bold so the marks "
                         "stand out in black; with the default --right plain the whole answer column is grey")
    ap.add_argument("--left-width", type=float, default=0.30,
                    help="Left column width as a fraction of the text width (default: 0.30)")
    ap.add_argument("--gap", type=float, default=1.0,
                    help="Blank lines between rows (default: 1.0; e.g. 1.5 or 2)")
    ap.add_argument("--rule", action="store_true", help="Draw a thin vertical line between the columns")
    ap.add_argument("--no-headings", action="store_true", help="Leave out the chapter/section headings")
    ap.add_argument("-s", "--font-size", help="Passed to md-to-pdf -s")
    ap.add_argument("-F", "--font-name", metavar="NAME",
                    help="Body font, any installed font (e.g. Roboto); passed to md-to-pdf -F")
    ap.add_argument("-i", "--italic", action="store_true", help="Passed to md-to-pdf -i")
    ap.add_argument("-p", "--page-number", choices=["tl", "tr", "tc", "bl", "br", "bc", "none"],
                    help="Page number position, passed to md-to-pdf -p (top/bottom + left/right/centre, or none)")
    ap.add_argument("--no-title", action="store_true", help="Don't print the file name as a title")
    ap.add_argument("--keep-md", action="store_true",
                    help="Also keep the intermediate files next to the output PDF (<name>_highlights.json and the recall .md)")
    ap.add_argument("--no-recursive", action="store_true", help="Folder mode: top level only")
    ap.add_argument("--stack-cmd", help="Command for stack-highlights (default: stack-highlights)")
    ap.add_argument("--md2pdf-cmd", help="Command for md-to-pdf (default: md-to-pdf)")
    args = ap.parse_args()

    if not 0.1 <= args.left_width <= 0.6:
        sys.exit("error: --left-width must be between 0.1 and 0.6")
    if args.max_words < 0:
        sys.exit("error: --max-words can't be negative")
    if args.word_window < 0:
        sys.exit("error: --word-window can't be negative")
    args.space_n = args.space_m = 0
    if args.space_every:
        m = re.match(r"^\s*(\d+)\s*[:, ]\s*(\d+)\s*$", args.space_every)
        if not m:
            sys.exit("error: --space-every must look like N:M, e.g. 5:10")
        args.space_n, args.space_m = int(m.group(1)), int(m.group(2))

    src = Path(args.input).expanduser()
    if not src.exists():
        sys.exit(f"error: {src} does not exist")

    md2pdf_cmd = resolve_cmd("md-to-pdf", args.md2pdf_cmd, "RECALL_MD2PDF_CMD")
    if args.font_name:
        # check the font now, not after extracting every book
        r = subprocess.run(md2pdf_cmd + ["--check-font", args.font_name], stdout=subprocess.PIPE, text=True)
        if r.returncode != 0:
            sys.exit(1)
        args.font_name = r.stdout.strip() or args.font_name

    if src.is_dir():
        if args.out:
            print("warning: -o/--out is ignored for folders", file=sys.stderr)
        walker = src.glob("*") if args.no_recursive else src.rglob("*")
        pdfs = sorted(p for p in walker if p.is_file() and p.suffix.lower() == ".pdf"
                      and not p.stem.endswith("_recall"))
        jobs = [(p, p.with_name(p.stem + "_recall.pdf")) for p in pdfs]
    else:
        if src.suffix.lower() not in (".pdf", ".md", ".json"):
            sys.exit("error: input must be a .pdf, an .md/.json from stack-highlights, or a folder")
        out = Path(args.out).expanduser() if args.out else src.with_name(src.stem + "_recall.pdf")
        jobs = [(src, out)]

    stack_cmd = None
    if any(p.suffix.lower() == ".pdf" for p, _ in jobs):
        stack_cmd = resolve_cmd("stack-highlights", args.stack_cmd, "RECALL_STACK_CMD")

    failed = 0
    for pdf, out in jobs:
        try:
            process(pdf, out, args, stack_cmd, md2pdf_cmd)
        except RuntimeError as e:
            print(f"  error    {pdf.name}: {e}", file=sys.stderr)
            failed += 1
    if not jobs:
        print("No PDFs found.", file=sys.stderr)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
