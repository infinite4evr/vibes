# stack-highlights configuration (example)
#
# Copy to ~/.config/stack-highlights.toml for your personal defaults, or drop a
# notes.toml next to a book for per-book settings. A command-line flag always
# wins over anything here. Keys are the long flag names; hyphens or underscores
# both work (context / plain-titles / word-window / margin ...).
#
# Precedence, lowest to highest:
#   built-in defaults < [defaults] here < --profile < --preset < CLI flags
#
# Check what a setup resolves to before a long run:
#   stack-highlights book.pdf --preset revise --dry-run


# ---- your personal defaults -------------------------------------------------
[defaults]
# context = "sentence"     # sentence | clause | comma | paragraph | highlight
# page-refs = true         # add "(p. N)" after each entry
# min-words = 6


# ---- presets: named bundles of flags (override the built-ins) ----------------
# Built-in presets already exist: print, revise, dense, act. Redefine one here
# to change it, or add your own. Use as:  --preset revise
[preset.revise]
context = "clause"
max-words = 25

[preset.print]
context = "sentence"

# A preset of your own, e.g. for making blank revision sheets:
[preset.blanks]
context = "clause"
space-every = "4:6"
space-style = "ruled"


# ---- publisher profiles: layout tuning per book -----------------------------
# Measure these once for a publisher whose layout trips the defaults, then reuse
# with  --profile laxmikanth . Only set what you actually need to change.
[profile.laxmikanth]
# margin = 0.08
# column-tolerance = 24

[profile.bare-act]
# keep-markers = true       # legal acts: keep the amendment brackets
# context = "clause"
