#!/usr/bin/env bash
# notes-recall: turn a folder of highlighted PDFs (or one PDF) into one notes
# PDF and one recall sheet.
#
# Usage: notes-recall [BOOKS] [NAME] [FONT]
#        notes-recall [-b|--books DIR|PDF] [-n|--name NAME] [-f|--font SIZE] [-F|--font-name NAME]
#                     [-P|--pages RANGE] [-p|--page-number [POS]] [-o|--out-dir DIR]
#   BOOKS / -b   Folder of highlighted PDFs, subfolders included, or a single
#                PDF (default: ~/Documents/Dump)
#   NAME  / -n   Base name of the output files (default: Dump)
#   FONT  / -f   Body font size in points for both PDFs (default: 14)
#   -F           Body font for both PDFs: any installed font, e.g. -F Roboto
#                or -F "Noto Serif" (default: Latin Modern Roman). Checked
#                before anything is extracted.
#   -P           Only read these pages, e.g. -P 1-200 or -P 1-20,35
#                (default: every page). These are the PDF's own page numbers
#                (1 = the first page of the file), not the numbers printed in
#                the book. With a folder, the range applies to every PDF in it.
#   -p           Print page numbers (default: no page numbers). Alone, -p puts
#                them at the bottom right; or name a position: br bl bc
#                (bottom right/left/centre), tr tl tc (top), e.g. -p bc
#   -o           Where to write the outputs (default: the folder that contains
#                BOOKS; for a single PDF, the folder that contains the PDF's
#                folder, the same place a run on that folder writes to). It
#                must not be inside the books folder: the next run would read
#                your notes PDFs as books.
#   --rule       Draw a vertical line between the recall columns.
#   --gap N      Vertical gap between recall rows (default: 1.0).
#   --right      How the answer column is rendered: plain, bold, or cloze
#                (default: bold).
#
# Example, pages 1-200 of one book:
#   notes-recall Dump/Book.pdf irll 18 -F "Charis SIL" -p -P 1-200
#
# Writes, in the output folder:
#   NAME.md          the combined notes (Markdown)
#   NAME.pdf         the notes as a PDF
#   NAME_recall.pdf  the two-column recall sheet (cues on the left; the
#                    answer on the right keeps the marked words in bold)
#
# Extraction settings: every mark kind (highlight, underline, squiggly,
# strikeout), comma context, non-yellow marks in bold italic, titles treated
# as plain text, one section per book.
#
# The recall sheet and the notes PDF are made independently: if one fails,
# the other is still made, and the run ends with a list of what was not.
# (Characters LaTeX cannot handle do not stop either: md-to-pdf names the
# note, prints it as plain text or leaves it out, and makes the rest.)
set -euo pipefail

# --help prints the comment block above, however long it gets
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"; }

books="$HOME/Documents/Dump"
name="Dump"
font="14"
font_name=""
pages=""             # e.g. 1-200 or 1-20,35; empty = every page
page_number="none"   # -p alone -> br; or bl bc tl tr tc
out_dir=""
recall_rule=false
recall_gap="1.0"
recall_right="bold"
positional=()

while [ $# -gt 0 ]; do
    case "$1" in
        -b|--books|-n|--name|-f|--font|-F|--font-name|-P|--pages|-o|--out-dir)
            if [ $# -lt 2 ]; then
                echo "Error: $1 needs a value" >&2
                exit 1
            fi
            case "$1" in
                -b|--books) books="$2" ;;
                -n|--name) name="$2" ;;
                -f|--font) font="$2" ;;
                -F|--font-name) font_name="$2" ;;
                -P|--pages) pages="$2" ;;
                -o|--out-dir) out_dir="$2" ;;
            esac
            shift 2
            ;;
        --rule)
            recall_rule=true
            shift
            ;;
        --gap)
            if [ $# -lt 2 ]; then
                echo "Error: --gap needs a value" >&2
                exit 1
            fi
            recall_gap="$2"
            if ! [[ "$recall_gap" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                echo "Error: gap must be a number, e.g. 1.0 or 1.5 (got '$recall_gap')" >&2
                exit 1
            fi
            shift 2
            ;;
        --right)
            if [ $# -lt 2 ]; then
                echo "Error: --right needs a value (plain, bold, or cloze)" >&2
                exit 1
            fi
            recall_right="$2"
            case "$recall_right" in
                plain|bold|cloze) ;;
                *)
                    echo "Error: --right must be plain, bold, or cloze (got '$recall_right')" >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        -p|--page-number)
            page_number="br"
            # optional position right after -p (anything else is left alone)
            case "${2:-}" in
                br|bl|bc|tr|tl|tc|none) page_number="$2"; shift ;;
            esac
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: unknown option $1 (see notes-recall --help)" >&2
            exit 1
            ;;
        *)
            positional+=("$1")
            shift
            ;;
    esac
done

if [ ${#positional[@]} -gt 3 ]; then
    echo "Error: too many arguments (expected BOOKS NAME FONT; see notes-recall --help)" >&2
    exit 1
fi
[ ${#positional[@]} -ge 1 ] && books="${positional[0]}"
[ ${#positional[@]} -ge 2 ] && name="${positional[1]}"
[ ${#positional[@]} -ge 3 ] && font="${positional[2]}"

# ---- check the inputs -------------------------------------------------------
# BOOKS may be one PDF: then $books becomes the folder it sits in (for the
# output-folder rules below) and only that PDF is read.
single_pdf=""
if [ -f "$books" ]; then
    case "$books" in
        *.[pP][dD][fF]) ;;
        *)
            echo "Error: BOOKS must be a folder or a .pdf file (got '$books')" >&2
            exit 1
            ;;
    esac
    single_pdf="$(cd "$(dirname "$books")" && pwd)/$(basename "$books")"
    books="$(dirname "$single_pdf")"
elif [ -d "$books" ]; then
    books="$(cd "$books" && pwd)"
else
    echo "Error: books folder or PDF not found: $books" >&2
    exit 1
fi

# same forms stack-highlights --pages reads: 5, 1-200, 150-, -20, joined by commas
if [ -n "$pages" ] && ! [[ "$pages" =~ ^([0-9]+(-[0-9]*)?|-[0-9]+)(,([0-9]+(-[0-9]*)?|-[0-9]+))*$ ]]; then
    echo "Error: pages must look like 1-200 or 1-20,35 (got '$pages')" >&2
    exit 1
fi

if [ -z "$name" ] || [[ "$name" == */* ]]; then
    echo "Error: name must be a plain file name without '/' (got '$name')" >&2
    exit 1
fi

if ! [[ "$font" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: font must be a number of points, e.g. 12 or 11.5 (got '$font')" >&2
    exit 1
fi

[ -z "$out_dir" ] && out_dir="$(dirname "$books")"
mkdir -p "$out_dir"
out_dir="$(cd "$out_dir" && pwd)"
case "$out_dir/" in
    "$books"/*)
        echo "Error: the output folder ($out_dir) is inside the books folder." >&2
        echo "The next run would read the notes PDFs as books. Choose another --out-dir." >&2
        exit 1
        ;;
esac

# ---- find the sibling commands (fall back to PATH) ---------------------------
cmd_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
tool() {
    if [ -x "$cmd_root/$1/$1" ]; then echo "$cmd_root/$1/$1"; else echo "$1"; fi
}
stack_cmd="$(tool stack-highlights)"
recall_cmd="$(tool recall-sheet)"
md2pdf_cmd="$(tool md-to-pdf)"

# ---- check the font name before the (slow) extraction -----------------------
font_args=()
if [ -n "$font_name" ]; then
    font_name="$("$md2pdf_cmd" --check-font "$font_name")" || exit 1
    font_args=(-F "$font_name")
fi

notes_md="$out_dir/$name.md"
notes_pdf="$out_dir/$name.pdf"
recall_pdf="$out_dir/${name}_recall.pdf"

echo "Books:  ${single_pdf:-$books}"
if [ -n "$pages" ]; then echo "Pages:  $pages (PDF page numbers)"; fi
if [ "$page_number" = "none" ]; then pages_msg="no page numbers"; else pages_msg="page numbers $page_number"; fi
rule_msg="no column rule"
[ "$recall_rule" = true ] && rule_msg="column rule"
echo "Output: $out_dir/$name{.md,.pdf,_recall.pdf}  (font ${font}pt${font_name:+, $font_name}, $pages_msg; recall: $recall_right, gap $recall_gap, $rule_msg)"
echo

# ---- 1. every PDF in the folder -> one combined Markdown file ---------------
# Written to a temporary file first, so a failed run leaves the previous
# notes untouched.
tmp_md=""
src_dir=""
cleanup() {
    if [ -n "$tmp_md" ]; then rm -f "$tmp_md"; fi
    # src_dir only ever holds symlinks; removing them leaves the book alone
    if [ -n "$src_dir" ]; then rm -f "$src_dir"/*; rmdir "$src_dir" 2>/dev/null || true; fi
}
trap cleanup EXIT
tmp_md="$(mktemp "$out_dir/.${name}.XXXXXX.md")"

# A single PDF is read through a temporary folder holding a link to it (and
# to the notes.toml beside it, if any), so the notes come out exactly as in
# folder mode: one section headed by the book's file name.
src="$books"
if [ -n "$single_pdf" ]; then
    src_dir="$(mktemp -d)"
    ln -s "$single_pdf" "$src_dir/$(basename "$single_pdf")"
    if [ -f "$books/notes.toml" ]; then ln -s "$books/notes.toml" "$src_dir/notes.toml"; fi
    src="$src_dir"
fi

page_args=()
if [ -n "$pages" ]; then page_args=(--pages "$pages"); fi

"$stack_cmd" "$src" \
    --kinds highlight,underline,squiggly,strikeout \
    --context comma \
    --italic-colors \
    --plain-titles \
    ${page_args[@]+"${page_args[@]}"} \
    --combine-out "$tmp_md"

if [ ! -s "$tmp_md" ]; then
    echo "Error: no highlights found in ${single_pdf:-$books}${pages:+ (pages $pages)}, so nothing was written." >&2
    exit 1
fi
mv -f "$tmp_md" "$notes_md"

# ---- 2. recall sheet ---------------------------------------------------------
# Steps 2 and 3 are independent: if one fails, the other still runs.
failed=()
echo
# (--md2pdf-cmd is split like a shell command line, so quote the path)
recall_args=(
    "$notes_md"
    -o "$recall_pdf"
    -s "$font"
    ${font_args[@]+"${font_args[@]}"}
    -p "$page_number"
    --right "$recall_right"
    --gap "$recall_gap"
    --md2pdf-cmd "$(printf '%q' "$md2pdf_cmd")"
)
if [ "$recall_rule" = true ]; then
    recall_args+=(--rule)
fi

if ! "$recall_cmd" "${recall_args[@]}"; then
    failed+=("recall sheet ($recall_pdf)")
fi

# ---- 3. notes PDF ------------------------------------------------------------
echo
if ! "$md2pdf_cmd" -s "$font" ${font_args[@]+"${font_args[@]}"} -p "$page_number" "$notes_md" "$notes_pdf"; then
    failed+=("notes PDF ($notes_pdf)")
fi

echo
if [ ${#failed[@]} -gt 0 ]; then
    echo "Finished with errors. Not made:"
    for f in "${failed[@]}"; do echo "  $f"; done
    echo "The notes Markdown is complete: $notes_md"
    exit 1
fi
echo "Done:"
echo "  $notes_md"
echo "  $notes_pdf"
echo "  $recall_pdf"
