local function join_abbr(inlines)
  local out, i = pandoc.List(), 1
  while i <= #inlines do
    local el = inlines[i]
    if el.t == "Str" and is_abbr(el.text) and inlines[i + 1] and inlines[i + 1].t == "Space"
        and inlines[i + 2] then
      -- the space after the abbreviation becomes non-breaking
      out:insert(pandoc.Str(el.text .. "\u{00A0}"))
      i = i + 2
    else
      out:insert(el)
      i = i + 1
    end
  end
  return out
end
local function typo_text(t, at_word_start)
  if not (t:find('["\']') or t:find("%-%-") or t:find("%.%.%.")) then
    return nil
  end
  local lead = ""
  if t:match("^%-%-%a") then
    lead, t = "--", t:sub(3)
  end
  t = t:gsub("%-%-%-", "\u{2014}"):gsub("%-%-", "\u{2013}"):gsub("%.%.%.", "\u{2026}")
  return lead .. curl(t, at_word_start)
end
local BREAK = { Space = true, SoftBreak = true, LineBreak = true }
local function typo(inlines)
  for i, el in ipairs(inlines) do
    if el.t == "Str" then
      local prev = inlines[i - 1]
      local t = typo_text(el.text, prev == nil or BREAK[prev.t] == true)
      if t then
        inlines[i] = pandoc.Str(t)
      end
    end
  end
  return inlines
end
