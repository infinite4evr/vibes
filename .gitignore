# ============================================================================
# 19. REPO-SPECIFIC RULES
# ============================================================================

# ---- Root ------------------------------------------------------------------
# Personal scratch folders and prompt notes, not part of any project
dump/
dump_old/
/todo.txt

# ---- commands/ -------------------------------------------------------------
# yt-subs-export / -subscribe / -sync: run state written on each run
progress.json
missing_channels.json

# wa-auto-delete: the whole data/ folder is a live Chromium profile
# (WhatsApp cookies, IndexedDB, login data, cache) plus runtime state.json
# and status.json. It holds an active WhatsApp login.
commands/wa-auto-delete/data/
# Stray screenshots from the pc command center, saved into the wrong folder
commands/wa-auto-delete/Claude outputs/

# stack-highlights: local config (copy of the tracked .toml.example)
commands/stack-highlights/stack-highlights.toml
# test scratch output (~230 MB of merged-book renders)
commands/stack-highlights/tests/.tmp/
# dev/ work dirs, regression output and generated visual-test output
commands/stack-highlights/dev/development-artifacts/work/
commands/stack-highlights/dev/toolchain/regression-results/
commands/stack-highlights/dev/visual-tests-500/outputs/
commands/stack-highlights/dev/original-upload/*.zip
# 266 MB test PDF + 159 MB zip; only the README explaining them is tracked
**/source-pdfs/*
!**/source-pdfs/README.md

# ---- linux-setup/ ----------------------------------------------------------
# pc/data/ (polkit policy + pc-admin helper) and pcctl/gui/data/ (app icon)
# are source and are tracked. Nothing extra to ignore beyond the generic
# Python rules above.

# ---- tgdrive/ --------------------------------------------------------------
# Runtime data dir when TGDRIVE_DATA points inside the repo: accounts,
# Telegram sessions, the search index, thumbnails, caches, logs
tgdrive/data/
# AppImage build workspace (tools stay tracked in packaging/)
tgdrive/packaging/AppDir/
tgdrive/packaging/build/


# ============================================================================
# 20. RE-INCLUDES: must stay last so they override the broad rules above
# ============================================================================

# Env templates are documentation, not secrets
!.env.example
!.env.sample
!.env.template

# Test fixtures are deliberately realistic samples (fake passwd/shadow,
# clamscan.log, shell histories, upower .dat, ...). Keep all of them.
!linux-setup/pc/tests/fixtures/**
!**/tests/fixtures/**
!**/tests/golden/**

# Git keep-files, for committing otherwise-empty directories
!.gitkeep
!**/.gitkeep
