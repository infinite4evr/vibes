# Optional. TG Drive asks for everything it needs in the app; these only
# override it when running from source (copy this file to .env).

# Telegram app key from https://my.telegram.org/apps (otherwise entered on first start)
# TG_API_ID=
# TG_API_HASH=

# Where accounts, the index, caches and logs live (default ~/.local/share/tgdrive)
# TGDRIVE_DATA=

# Server-only mode (python run.py). Keep 127.0.0.1 unless you also set a password.
# TGDRIVE_HOST=127.0.0.1
# TGDRIVE_PORT=8765
# TGDRIVE_PASSWORD=

# Desktop app troubleshooting
# TGDRIVE_NO_GPU=1          software rendering (graphics driver problems)
# TGDRIVE_NO_SANDBOX=1      only if the window stays blank on your system
